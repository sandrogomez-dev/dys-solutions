# DYS Solutions - Variables de Entorno

# API Key de DeepSeek (requerida para el chatbot)
# Obtén tu clave en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Key de Resend (opcional, para recibir emails de leads capturados)
# Obtén tu clave en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email donde recibirás las notificaciones de nuevos leads (por defecto hola@dyssolutions.com)
LEAD_TO_EMAIL=hola@dyssolutions.com
